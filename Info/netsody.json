  "post_install_steps": [
    {
      "command": {
        "path": "openssl"
      },
      "stdout_path": {
        "path": "{{etc}}/netsody/auth.token"
      },
      "guards": [
        {
          "path": "{{etc}}/netsody/auth.token",
          "condition": "unless_exists",
          "id": "1"
        }
      ],
      "type": "run",
      "args": [
